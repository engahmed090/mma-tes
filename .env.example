# Public browser configuration only. Never put service-role keys or secrets in VITE_*.
# Empty prediction base uses same-origin /api (Vite proxies locally in development).
VITE_PREDICTION_API_URL=
# Optional external/local Streamlit service; disabled when empty.
VITE_STREAMLIT_URL=
# Copy the existing public Supabase values if overriding them in .env.local.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=

# Normal chat uses the same-origin Node endpoint. Optional public endpoint override:
VITE_AI_CHAT_API_URL=
# Server-only; set privately in Vercel or ignored .env.local. Never prefix secrets with VITE_.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# TAVILY_API_KEY=
